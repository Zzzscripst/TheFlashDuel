-- SUA FUNÇÃO DROP BRAINROT ORIGINAL
local function DropBrainrot()
    local now = tick()
    if now - dropLastJump < 0.4 then return end
    if dropJumping then return end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    
    dropLastJump = now
    dropJumping = true
    
    local groundPos = hrp.Position
    
    hum:ChangeState(Enum.HumanoidStateType.Jumping)
    hrp.AssemblyLinearVelocity = Vector3.new(
        hrp.AssemblyLinearVelocity.X,
        140,
        hrp.AssemblyLinearVelocity.Z
    )
    
    task.delay(0.18, function()
        if hrp then
            hrp.CFrame = CFrame.new(groundPos)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
        task.delay(0.1, function()
            dropJumping = false
        end)
    end)
end

-- CONTROLE INSTANTÂNEO DO TOGGLE DROP BRAINROT (Sem delay!)
local function setDropBrainrotState(enabled)
    dropBrainrotActive = enabled
    if enabled then
        print("Drop Brainrot Ativado Instantaneamente!")
        if brainrotConnection then brainrotConnection:Disconnect() end
        
        brainrotConnection = RunService.Heartbeat:Connect(function()
            if not dropBrainrotActive then return end
            DropBrainrot()
        end)
    else
        print("Drop Brainrot Desativado!")
        if brainrotConnection then
            brainrotConnection:Disconnect()
            brainrotConnection = nil
        end
        dropJumping = false
    end
end

