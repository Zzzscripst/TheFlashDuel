    local isActive = initialStatus

    switchBG.MouseButton1Click:Connect(function()
        isActive = not isActive
        
        if text:lower():find("lag") then lagBombActive = isActive 
        elseif text:lower():find("speed") then speedActive = isActive 
        elseif text:lower():find("infinite") then infJump = isActive
